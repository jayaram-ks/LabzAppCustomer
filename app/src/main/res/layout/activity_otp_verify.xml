<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/white"
    android:orientation="vertical"
    >

    <TextView
        android:layout_width="match_parent"
        android:layout_height="?android:attr/actionBarSize"
        android:background="@color/orange"
        android:gravity="center|start"
        android:fontFamily="@font/blippo_black_regular"
        android:textColor="@color/white"
        android:textSize="25dp"
        android:paddingStart="20dp"
        android:text="@string/app_title" />

    <androidx.cardview.widget.CardView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_margin="20dp"
        app:cardBackgroundColor="@color/white"
        app:cardCornerRadius="20dp"
        android:layout_marginTop="2dp"
        app:cardElevation="7dp">



        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_margin="10dp"
            android:orientation="vertical">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginLeft="5dp"
                android:layout_marginTop="5dp"
                android:layout_marginRight="5dp"
                android:text="OTP Verification"
                android:gravity="center"
                android:textColor="@color/title_black"
                android:fontFamily="@font/lato_black"
                android:textSize="18sp" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginLeft="5dp"
                android:id="@+id/otp_messg"
                android:layout_marginTop="15dp"
                android:layout_marginBottom="15dp"
                android:layout_marginRight="5dp"
                android:gravity="left"
                android:textColor="@color/textBlack"
                android:textSize="15sp" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal">


                <com.poovam.pinedittextfield.SquarePinField
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:textSize="18sp"
                    android:textSelectHandle="@drawable/text_handle"
                    android:fontFamily="@font/lato_bold"
                    app:noOfFields="6"
                    app:distanceInBetween="10dp"
                    app:fieldBgColor="@color/light_grey"
                    app:fieldColor="@color/medium_grey"
                    app:highlightColor="@color/dark_grey"
                    app:highlightType="currentField"
                    android:hint="000000"
                    android:id="@+id/squareField1"
                    app:cornerRadius="6dp"
                    android:layout_marginTop="15dp"/>

            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_horizontal"
                android:layout_marginTop="15dp"
                android:orientation="vertical"
                android:paddingBottom="10dp">

                <TextView
                    android:id="@+id/otp_txt"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text=""
                    android:textColor="@color/black"
                    android:textSize="18sp"
                    />

                <Button
                    android:layout_width="wrap_content"
                    android:id="@+id/cancel_otp"
                    android:layout_height="45dp"
                    android:layout_marginTop="30dp"
                    android:text="@string/cancel"
                    android:textSize="12sp"
                    app:backgroundTint="@color/orange" />
            </LinearLayout>

        </LinearLayout>


    </androidx.cardview.widget.CardView>


    <View
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:layout_weight=".3" />

</LinearLayout>