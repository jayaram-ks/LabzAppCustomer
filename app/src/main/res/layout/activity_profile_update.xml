<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/white"
    android:orientation="vertical">

    <TextView
        android:layout_width="match_parent"
        android:layout_height="30dp"
        android:background="@color/orange"
        android:gravity="center|start"
        android:paddingStart="10dp"
        android:paddingEnd="10dp"
        android:text="@string/user_details"
        android:textColor="@color/white"
        android:textSize="16sp"
        android:textStyle="bold" />



        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingTop="0dp"
            android:paddingBottom="20dp">

            <LinearLayout
                android:orientation="vertical"
                android:layout_width="match_parent"
                android:layout_height="wrap_content">

            <FrameLayout
                android:layout_width="match_parent"
                android:layout_height="match_parent">

                    <fragment
                        android:id="@+id/map"
                        class="com.google.android.gms.maps.SupportMapFragment"
                        android:layout_width="match_parent"
                        android:layout_height="180dp" />
            </FrameLayout>
               <LinearLayout
                   android:layout_width="match_parent"
                   android:layout_height="wrap_content"
                   android:orientation="horizontal"
                   android:gravity="center_horizontal">
               <TextView
                   android:layout_width="wrap_content"
                   android:layout_height="wrap_content"
                   android:paddingStart="8dp"
                   android:text="Latitude : "
                   android:textColor="@color/textBlack"
                   android:textSize="13sp"
                   android:fontFamily="@font/roboto_condensed_regular"/>
                <TextView
                    android:id="@+id/usr_lat"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:paddingStart="1dp"
                    android:paddingEnd="8dp"
                    android:text=""
                    android:textColor="@color/textBlack"
                    android:textSize="13sp"
                    android:fontFamily="@font/roboto_condensed_regular"/>
               <TextView
                   android:layout_width="wrap_content"
                   android:layout_height="wrap_content"
                   android:text="Longitude : "
                   android:textColor="@color/textBlack"
                   android:textSize="13sp"
                   android:fontFamily="@font/roboto_condensed_regular"/>
                <TextView
                    android:id="@+id/usr_long"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:paddingStart="1dp"
                    android:paddingEnd="8dp"
                    android:text=""
                    android:textColor="@color/textBlack"
                    android:textSize="13sp"
                    android:fontFamily="@font/roboto_condensed_regular"/>
            </LinearLayout>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal">
                    <TextView
                        android:layout_width="15dp"
                        android:layout_height="15dp"

                        android:layout_marginLeft="8dp"
                        android:layout_marginTop="2dp"
                        android:background="@drawable/ic_placeholder"

                       />
                    <TextView
                        android:id="@+id/location_address"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Please select your Location"
                        android:fontFamily="@font/roboto_condensed_regular"
                        android:layout_gravity="left"
                        android:layout_marginTop="0dp"
                        android:textColor="@color/textBlack"


                        android:paddingStart="5dp"
                        android:paddingEnd="8dp"
                        android:textSize="14sp" />
                </LinearLayout>

                <LinearLayout
                    android:orientation="horizontal"
                    android:paddingStart="10dp"
                    android:paddingEnd="10dp"
                    android:layout_gravity="center_horizontal"
                    android:layout_width="match_parent"
                    android:layout_height="55dp">

                <TextView
                    app:backgroundTint="@color/green"
                    android:id="@+id/textVwLocation"
                    android:layout_width="wrap_content"
                    android:layout_height="30dp"
                    android:layout_margin="10dp"
                    android:paddingStart="3dp"
                    android:paddingEnd="3dp"
                    android:fontFamily="@font/roboto_condensed_regular"
                    android:textSize="14sp"
                    android:background="@drawable/round_button_white"
                    android:elevation="5dp"
                    android:gravity="center"
                    android:layout_weight="5"
                    android:text="@string/use_current_location"
                    android:textColor="@color/white" />


                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="20dp"
                    android:text="@string/or"
                    android:layout_weight="1"
                    android:gravity="clip_vertical"
                    android:layout_marginTop="10dp"
                    android:textColor="@color/textBlack"
                    android:fontFamily="@font/roboto_condensed_regular"
                    android:textSize="10sp" />

                <TextView
                    app:backgroundTint="@color/green"
                    android:id="@+id/loc_search_map"
                    android:layout_width="wrap_content"
                    android:layout_height="30dp"
                    android:layout_margin="10dp"
                    android:paddingStart="3dp"
                    android:paddingEnd="3dp"
                    android:background="@drawable/round_button_white"
                    android:elevation="5dp"
                    android:gravity="center"
                    android:layout_weight="5"
                    android:fontFamily="@font/roboto_condensed_regular"
                    android:textSize="14sp"
                    android:text="@string/select_location_from_map"
                    android:textColor="@color/white" />

                </LinearLayout>


            </LinearLayout>


            <EditText
                android:layout_width="match_parent"
                android:layout_height="40dp"
                android:layout_marginStart="30dp"
                android:layout_marginEnd="30dp"
                android:layout_marginBottom="10dp"
                android:background="@drawable/round_button_white"
                android:elevation="5dp"
                android:hint="@string/name"
                android:inputType="text"
                android:paddingStart="15dp"
                android:paddingEnd="10dp" />


            <EditText
                android:layout_width="match_parent"
                android:layout_height="40dp"
                android:layout_marginStart="30dp"
                android:layout_marginEnd="30dp"
                android:layout_marginBottom="10dp"
                android:background="@drawable/round_button_white"
                android:elevation="5dp"
                android:hint="@string/age"
                android:inputType="number"
                android:paddingStart="15dp"
                android:paddingEnd="10dp" />


            <RadioGroup
                android:id="@+id/daily_weekly_button_view"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:paddingStart="30dp"
                android:paddingEnd="30dp">

                <RadioButton
                    android:id="@+id/radio0"
                    android:layout_width="115dp"
                    android:layout_height="30dp"
                    android:layout_marginBottom="10dp"
                    android:background="@drawable/radio_flat_selector"
                    android:button="@android:color/transparent"
                    android:checked="true"
                    android:elevation="3dp"
                    android:gravity="center"
                    android:text="@string/male"
                    android:layout_weight="1"
                    android:textColor="@drawable/radio_flat_text_selector" />

                <RadioButton
                    android:id="@+id/radio1"
                    android:layout_width="115dp"
                    android:layout_height="30dp"
                    android:layout_marginStart="20dp"
                    android:layout_marginBottom="10dp"
                    android:background="@drawable/radio_flat_selector"
                    android:button="@android:color/transparent"
                    android:elevation="5dp"
                    android:layout_weight="1"
                    android:gravity="center"
                    android:text="@string/female"
                    android:textColor="@drawable/radio_flat_text_selector" />

            </RadioGroup>

            <EditText
                android:layout_width="match_parent"
                android:layout_height="40dp"
                android:layout_marginStart="30dp"
                android:layout_marginEnd="30dp"
                android:layout_marginBottom="10dp"
                android:background="@drawable/round_button_white"
                android:elevation="5dp"
                android:hint="@string/address"
                android:inputType="textPostalAddress"
                android:paddingStart="15dp"
                android:paddingEnd="10dp" />

            <EditText
                android:layout_width="match_parent"
                android:layout_height="40dp"
                android:layout_marginStart="30dp"
                android:layout_marginEnd="30dp"
                android:layout_marginBottom="10dp"
                android:background="@drawable/round_button_white"
                android:elevation="5dp"
                android:hint="@string/mobile_number"
                android:inputType="phone"
                android:paddingStart="15dp"
                android:paddingEnd="10dp" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="40dp"
                android:layout_marginStart="30dp"
                android:layout_marginEnd="30dp"
                android:layout_marginBottom="10dp"
                android:background="@drawable/round_button_white"
                android:elevation="5dp"
                android:orientation="horizontal"
                android:paddingStart="15dp"
                android:paddingEnd="10dp">

                <Spinner
                    android:id="@+id/cdistrict"
                    android:dropDownWidth="wrap_content"
                    android:spinnerMode="dropdown"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent" />

            </LinearLayout>

            <Button
                android:layout_width="match_parent"
                android:layout_height="40dp"
                android:layout_marginStart="100dp"
                android:layout_marginEnd="100dp"
                android:layout_marginBottom="20dp"
                app:backgroundTint="@color/green"
                android:background="@drawable/round_button_white"
                android:elevation="5dp"
                android:text="@string/submit"
                android:textAllCaps="false" />

        </LinearLayout>






</LinearLayout>