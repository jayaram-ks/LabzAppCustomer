<?xml version="1.0" encoding="utf-8"?>

<com.google.android.material.card.MaterialCardView
    android:layout_height="wrap_content"
    android:layout_width="match_parent"
    app:cardCornerRadius="10dp"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    app:strokeColor="@color/pack_border"
    app:strokeWidth="1dp"
    app:cardBackgroundColor="@color/white"
    android:layout_marginVertical="4dp"
    xmlns:android="http://schemas.android.com/apk/res/android">

    <LinearLayout android:orientation="vertical"
        android:layout_width="match_parent"
        android:layout_height="wrap_content">
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textColor="@color/white"
            android:background="@color/pack_col"
            android:paddingVertical="4dp"
            android:paddingHorizontal="10dp"
            android:letterSpacing=".01"
            android:textSize="14sp"
            android:id="@+id/pack_title"
            android:shadowColor = "@color/txtShadow"
            android:shadowDx = "2"
            android:shadowDy = "2"
            android:shadowRadius = "2"
            />

        <ImageView
            android:id="@+id/list_pack_img"
            android:layout_height="170dp"
            android:layout_width="match_parent"
            android:scaleType="fitXY"
            />
        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:background="@color/transp_black"
            />
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:orientation="vertical"
            >

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:paddingHorizontal="8dp"
                android:paddingVertical="4dp">
                <TextView
                    android:id="@+id/pack_rate1"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:textColor="@color/orange"
                    android:textStyle="bold"
                    android:textSize="15sp" />
                <TextView
                    android:id="@+id/pack_rate2"
                    android:textStyle="normal"
                    android:paddingStart="10dp"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:textColor="@color/textBlack"
                    android:textSize="13sp" />

            </LinearLayout>


            <TextView
                android:id="@+id/pack_details"
                android:gravity="top"
                android:paddingHorizontal="8dp"
                android:paddingBottom="5dp"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:maxLines="5"
                android:ellipsize="end"
                android:letterSpacing=".01"
                android:layout_weight="1"
                android:textColor="@color/textBlack"
                android:textSize="13sp" />

        </LinearLayout>

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textColor="@color/white"
            android:background="@color/pack_col"
            android:paddingVertical="4dp"
            android:paddingHorizontal="10dp"
            android:textSize="14sp"
            android:id="@+id/pack_footer"
            android:shadowColor = "@color/txtShadow"
            android:shadowDx = "1"
            android:shadowDy = "1"
            android:shadowRadius = "2"
            />

    </LinearLayout>
</com.google.android.material.card.MaterialCardView>