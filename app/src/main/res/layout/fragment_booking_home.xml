<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/white"
    android:orientation="vertical">

    <TextView
        android:layout_width="match_parent"
        android:layout_height="?android:attr/actionBarSize"
        android:background="@color/orange"
        android:gravity="center|start"
        android:paddingStart="10dp"
        android:paddingEnd="10dp"
        android:text="Book Lab Tests "
        android:textColor="@color/white"
        android:textSize="20sp"
        android:textStyle="bold"
        android:layout_marginBottom="10dp"/>






    <androidx.cardview.widget.CardView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginStart="10dp"
        android:layout_marginEnd="10dp"
        android:layout_marginBottom="10dp"
        app:cardBackgroundColor="@color/white"
        app:cardCornerRadius="10dp"
        app:cardElevation="15dp">
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">


        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textColor="@color/white"
            android:background="@color/green"
            android:paddingVertical="4dp"
            android:paddingHorizontal="10dp"
            android:textSize="14sp"
            android:id="@+id/lab_title"
            android:text="Patient's Location"
            android:shadowColor = "@color/txtShadow"
            android:shadowDx="2"
            android:shadowDy="2"
            android:shadowRadius="2"
            />


            <RelativeLayout android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:layout_gravity="center_horizontal">
                <fragment
                    android:id="@+id/map_book"
                    class="com.google.android.gms.maps.SupportMapFragment"
                    android:layout_width="match_parent"
                    android:layout_height="150dp" />

                <LinearLayout android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:paddingStart="3dp"
                    android:orientation="horizontal">
                    <TextView
                        android:id="@+id/usr_lat"
                        android:paddingEnd="5dp"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:textColor="@color/white"
                        android:shadowColor="@color/black"
                        android:shadowRadius="5"
                        android:shadowDx="0"
                        android:shadowDy="0"
                        android:fontFamily="@font/roboto_condensed_regular"
                        android:textSize="9sp"
                        />
                    <TextView
                        android:id="@+id/usr_long"
                        android:paddingEnd="5dp"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:textColor="@color/white"
                        android:shadowColor="@color/black"
                        android:shadowRadius="5"
                        android:shadowDx="0"
                        android:shadowDy="0"
                        android:fontFamily="@font/roboto_condensed_regular"
                        android:textSize="9sp"
                        />
                </LinearLayout>

            </RelativeLayout>


            <TextView
                android:id="@+id/location_address"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:textColor="@color/white"
                android:background="@color/green"
                android:paddingVertical="4dp"
                android:paddingHorizontal="10dp"
                android:textSize="12sp"
                android:fontFamily="@font/roboto_condensed_regular"

                />
        </LinearLayout>

    </androidx.cardview.widget.CardView>


    <androidx.cardview.widget.CardView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginStart="10dp"
        android:layout_marginEnd="10dp"
        android:layout_marginBottom="10dp"
        app:cardBackgroundColor="@color/white"
        app:cardCornerRadius="10dp"
        app:cardElevation="15dp">
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">


            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:textColor="@color/white"
                android:background="@color/green"
                android:paddingVertical="4dp"
                android:paddingHorizontal="10dp"
                android:textSize="14sp"
                android:id="@+id/lab_daad"
                android:text="Preferred Date"
                android:shadowColor = "@color/txtShadow"
                android:shadowDx="2"
                android:shadowDy="2"
                android:shadowRadius="2"
                />
            <LinearLayout android:layout_height="wrap_content"
                android:layout_width="match_parent" android:orientation="horizontal"
                android:paddingHorizontal="5dp">
            <TextView
                android:id="@+id/text_view_date_1"
                android:layout_width="0dp"
                android:layout_weight="2"
                android:layout_height="wrap_content"
                android:textSize="16sp"
                android:gravity="center_horizontal"
                android:padding="5dp" />

            <Button
                android:id="@+id/button_date_1"
                android:layout_width="0dp"
                android:layout_marginStart="5dp"
                android:layout_weight="1"
                android:textAllCaps="false"
                android:letterSpacing=".01"
                android:layout_height="40dp"
                android:text="Change"
                android:backgroundTint="@color/green"/>
            </LinearLayout>

        </LinearLayout>

    </androidx.cardview.widget.CardView>



    <androidx.cardview.widget.CardView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginStart="10dp"
        android:layout_marginEnd="10dp"
        android:layout_marginBottom="10dp"
        app:cardBackgroundColor="@color/white"
        app:cardCornerRadius="10dp"
        app:cardElevation="15dp">
        <LinearLayout
            android:id="@+id/req_lab_tests"
            android:foreground="?android:attr/selectableItemBackground"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">


            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:textColor="@color/white"
                android:background="@color/green"
                android:paddingTop="4dp"
                android:paddingHorizontal="10dp"
                android:textSize="14sp"
                android:text="Required Lab Tests(Click to Add)"
                android:shadowColor = "@color/txtShadow"
                android:shadowDx="2"
                android:shadowDy="2"
                android:shadowRadius="2"
                />
            <TextView
                android:id="@+id/home_test_count"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="start"
                android:background="@color/green"
                android:paddingHorizontal="10dp"
                android:paddingBottom="3dp"
                android:fontFamily="@font/roboto_condensed_regular"
                android:text="No tests selected"
                android:textColor="@color/white"
                android:textSize="12sp" />

        </LinearLayout>

    </androidx.cardview.widget.CardView>

    <androidx.cardview.widget.CardView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginStart="10dp"
        android:layout_marginEnd="10dp"
        android:layout_marginBottom="10dp"
        app:cardBackgroundColor="@color/white"
        app:cardCornerRadius="10dp"
        app:cardElevation="15dp">
        <LinearLayout
            android:id="@+id/selected_lab"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:foreground="?android:attr/selectableItemBackground">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:textColor="@color/white"
                android:background="@color/green"
                android:paddingVertical="4dp"
                android:paddingHorizontal="10dp"
                android:textSize="14sp"
                android:id="@+id/labtitle"
                android:text="Preferred Laboratory"
                android:shadowColor = "@color/txtShadow"
                android:shadowDx="2"
                android:shadowDy="2"
                android:shadowRadius="2"
                />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="left|start"
                android:background="@color/green"
                android:orientation="horizontal"
                >

                <ImageView
                    android:layout_width="60dp"
                    android:layout_height="60dp"

                    android:src="@drawable/no_image" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:gravity="center"
                    android:padding="5dp"
                    android:fontFamily="@font/roboto_condensed_regular"
                    android:text="@string/ayur_anchal_road_sh1_kollam_691532"
                    android:textColor="@color/white"
                    android:textSize="12sp" />

            </LinearLayout>
        </LinearLayout>

    </androidx.cardview.widget.CardView>

    <View
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:layout_weight="1" />

    <androidx.appcompat.widget.AppCompatButton

        android:layout_width="170dp"
        android:layout_height="50dp"
        android:layout_gravity="center"
        android:layout_marginBottom="30dp"
        android:background="@drawable/round_button_white"
        android:backgroundTint="@color/orange"
        android:elevation="5dp"
        android:text="@string/_continue"
        android:textAllCaps="false"
        android:textColor="@color/white" />

</LinearLayout>