<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/white"
    android:orientation="vertical">
    <TextView
        android:layout_width="match_parent"
        android:layout_height="?android:attr/actionBarSize"
        android:background="@color/orange"
        android:gravity="center|start"
        android:paddingStart="10dp"
        android:paddingEnd="10dp"
        android:text="Book Tests Package "
        android:textColor="@color/white"
        android:textSize="20sp"
        android:textStyle="bold"
        android:layout_marginBottom="10dp"/>
    <androidx.cardview.widget.CardView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginStart="10dp"
        android:layout_marginEnd="10dp"
        android:layout_marginBottom="10dp"
        app:cardBackgroundColor="@color/white"
        app:cardCornerRadius="10dp"
        app:cardElevation="15dp">
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:textColor="@color/white"
                android:background="@color/success_green"
                android:paddingVertical="4dp"
                android:paddingHorizontal="10dp"
                android:textSize="14sp"
                android:id="@+id/lab_title"
                android:text="Patient's Location"
                android:shadowColor = "@color/txtShadow"
                android:shadowDx="2"
                android:shadowDy="2"
                android:shadowRadius="2"
                />
            <RelativeLayout android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:layout_gravity="center_horizontal">
                <fragment
                    android:id="@+id/map_book"
                    class="com.google.android.gms.maps.SupportMapFragment"
                    android:layout_width="match_parent"
                    android:layout_height="150dp" />
                <ImageView
                    android:layout_width="36dp"
                    android:layout_height="36dp"
                    android:layout_centerHorizontal="true"
                    android:layout_centerVertical="true"
                    android:src="@drawable/ic_google_maps"
                    />

                <LinearLayout android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:paddingStart="3dp"
                    android:orientation="horizontal">
                    <TextView
                        android:id="@+id/usr_lat"
                        android:paddingEnd="5dp"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:textColor="@color/white"
                        android:shadowColor="@color/black"
                        android:shadowRadius="5"
                        android:shadowDx="0"
                        android:shadowDy="0"
                        android:fontFamily="@font/roboto_condensed_regular"
                        android:textSize="9sp"
                        />
                    <TextView
                        android:id="@+id/usr_long"
                        android:paddingEnd="5dp"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:textColor="@color/white"
                        android:shadowColor="@color/black"
                        android:shadowRadius="5"
                        android:shadowDx="0"
                        android:shadowDy="0"
                        android:fontFamily="@font/roboto_condensed_regular"
                        android:textSize="9sp"
                        />
                </LinearLayout>

            </RelativeLayout>


            <TextView
                android:id="@+id/location_address"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:textColor="@color/white"
                android:background="@color/success_green"
                android:paddingVertical="4dp"
                android:paddingHorizontal="10dp"
                android:textSize="12sp"
                android:fontFamily="@font/roboto_condensed_regular"

                />
        </LinearLayout>

    </androidx.cardview.widget.CardView>

    <androidx.core.widget.NestedScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:fillViewport="true">
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">
    <androidx.cardview.widget.CardView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginStart="10dp"
        android:layout_marginEnd="10dp"
        android:layout_marginBottom="10dp"
        app:cardBackgroundColor="@color/white"
        app:cardCornerRadius="10dp"
        app:cardElevation="15dp">
        <LinearLayout
            android:id="@+id/button_date_1"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:textColor="@color/white"
                android:background="@color/success_green"
                android:paddingTop="4dp"
                android:paddingHorizontal="10dp"
                android:textSize="14sp"
                android:id="@+id/lab_daad"
                android:text="Preferred Date (Click to change)"
                android:shadowColor = "@color/txtShadow"
                android:shadowDx="2"
                android:shadowDy="2"
                android:shadowRadius="2"
                />
            <LinearLayout android:layout_height="wrap_content"
                android:layout_width="match_parent"
                android:orientation="horizontal">
                <TextView
                    android:id="@+id/text_view_date_1"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:textSize="13sp"
                    android:gravity="start"
                    android:paddingHorizontal="10dp"
                    android:paddingBottom="5dp"
                    android:textColor="@color/white"
                    android:background="@color/success_green" />

            </LinearLayout>

        </LinearLayout>
    </androidx.cardview.widget.CardView>



    <androidx.cardview.widget.CardView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginStart="10dp"
        android:layout_marginEnd="10dp"
        app:cardBackgroundColor="@color/white"
        app:cardCornerRadius="10dp"
        app:cardElevation="15dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textColor="@color/white"
            android:background="@color/pack_col"
            android:paddingVertical="4dp"
            android:paddingHorizontal="10dp"
            android:textSize="14sp"
            android:id="@+id/pack_title"
            android:shadowColor = "@color/txtShadow"
            android:shadowDx = "2"
            android:shadowDy = "2"
            android:shadowRadius = "2"
            />
        <ImageView
            android:id="@+id/pack_img"
            android:layout_height="180dp"
            android:layout_width="match_parent"
            android:scaleType="fitXY"
            />

        <TextView
            android:id="@+id/tests_details"
            android:gravity="top"
            android:paddingHorizontal="8dp"
            android:paddingTop="5dp"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:ellipsize="end"
            android:maxLines="25"
            android:lineHeight="12sp"
            android:letterSpacing=".01"
            android:textColor="@color/textBlack"
            android:textSize="12sp" />


        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:paddingHorizontal="8dp"
            android:paddingVertical="2dp">
            <TextView
                android:id="@+id/pack_rate1"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textColor="@color/orange"
                android:textStyle="bold"
                android:textSize="15sp" />
            <TextView
                android:id="@+id/pack_rate2"
                android:paddingStart="10dp"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textColor="@color/textBlack"
                android:textSize="13sp" />

        </LinearLayout>

        <TextView
            android:id="@+id/lab_name"
            android:gravity="top"
            android:paddingHorizontal="8dp"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:ellipsize="end"
            android:maxLines="25"
            android:lineHeight="12sp"
            android:letterSpacing=".01"
            android:textColor="@color/textBlack"
            android:textSize="12sp" />
        <TextView
            android:id="@+id/lab_address"
            android:gravity="top"
            android:paddingHorizontal="8dp"
            android:paddingBottom="7dp"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:ellipsize="end"
            android:maxLines="25"
            android:lineHeight="12sp"
            android:letterSpacing=".01"
            android:textColor="@color/textBlack"
            android:textSize="12sp" />
        </LinearLayout>

    </androidx.cardview.widget.CardView>


    <androidx.appcompat.widget.AppCompatButton
        android:id="@+id/continue_book_btn"
        android:layout_width="170dp"
        android:layout_height="50dp"
        android:layout_marginTop="15dp"
        android:layout_gravity="center"
        android:layout_marginBottom="30dp"
        android:background="@drawable/round_button_white"
        android:backgroundTint="@color/orange"
        android:elevation="5dp"
        android:text="@string/_continue"
        android:textAllCaps="false"
        android:textColor="@color/white" />

        </LinearLayout>
    </androidx.core.widget.NestedScrollView>
</LinearLayout>