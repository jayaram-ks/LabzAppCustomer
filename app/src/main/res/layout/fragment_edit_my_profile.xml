<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/transp_black"
    android:orientation="vertical">

    <TextView
        android:layout_width="match_parent"
        android:layout_height="40dp"
        android:background="@color/orange"
        android:gravity="bottom|start"
        android:paddingStart="10dp"
        android:paddingEnd="10dp"
        android:paddingBottom="8dp"
        android:text="Update Location and Profile"
        android:textColor="@color/white"
        android:textSize="15sp"
        android:textStyle="bold" />

    <androidx.cardview.widget.CardView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp"
        android:layout_marginStart="10dp"
        android:layout_marginEnd="10dp"

        app:cardBackgroundColor="@color/white"
        app:cardCornerRadius="10dp"
        app:cardElevation="15dp">
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:textColor="@color/white"
                android:background="@color/green"
                android:paddingVertical="4dp"
                android:paddingHorizontal="10dp"
                android:textSize="14sp"
                android:id="@+id/lab_title"
                android:text="My Location"
                android:shadowColor = "@color/txtShadow"
                android:shadowDx="2"
                android:shadowDy="2"
                android:shadowRadius="2"
                />
            <RelativeLayout android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:layout_gravity="center_horizontal">
                <fragment
                    android:id="@+id/map_profiledit"
                    class="com.google.android.gms.maps.SupportMapFragment"
                    android:layout_width="match_parent"
                    android:layout_height="150dp" />
                <ImageView
                    android:layout_width="36dp"
                    android:layout_height="36dp"
                    android:layout_centerHorizontal="true"
                    android:layout_centerVertical="true"
                    android:src="@drawable/ic_google_maps"
                    />

                <LinearLayout android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:paddingStart="3dp"
                    android:orientation="horizontal">
                    <TextView
                        android:id="@+id/usr_lat"
                        android:paddingEnd="5dp"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:textColor="@color/white"
                        android:shadowColor="@color/black"
                        android:shadowRadius="5"
                        android:shadowDx="0"
                        android:shadowDy="0"
                        android:fontFamily="@font/roboto_condensed_regular"
                        android:textSize="9sp"
                        />
                    <TextView
                        android:id="@+id/usr_long"
                        android:paddingEnd="5dp"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:textColor="@color/white"
                        android:shadowColor="@color/black"
                        android:shadowRadius="5"
                        android:shadowDx="0"
                        android:shadowDy="0"
                        android:fontFamily="@font/roboto_condensed_regular"
                        android:textSize="9sp"
                        />
                </LinearLayout>

            </RelativeLayout>


            <TextView
                android:id="@+id/location_address"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:textColor="@color/white"
                android:background="@color/green"
                android:paddingVertical="4dp"
                android:paddingHorizontal="10dp"
                android:textSize="12sp"
                android:fontFamily="@font/roboto_condensed_regular"

                />
        </LinearLayout>

    </androidx.cardview.widget.CardView>

<ScrollView
    android:layout_width="match_parent"
    android:layout_height="match_parent">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"

            android:paddingBottom="10dp">

            <EditText
                android:id="@+id/my_name"
                android:layout_marginTop="10dp"
                android:layout_width="match_parent"
                android:layout_height="40dp"
                android:layout_marginStart="10dp"
                android:layout_marginEnd="10dp"
                android:layout_marginBottom="10dp"
                android:background="@drawable/round_button_white"
                android:elevation="5dp"
                android:hint="Name"
                android:inputType="text"
                android:paddingStart="15dp"
                android:paddingEnd="10dp"
                android:textSize="15sp"/>


            <EditText
                android:id="@+id/my_age"
                android:layout_width="match_parent"
                android:layout_height="40dp"
                android:layout_marginStart="10dp"
                android:layout_marginEnd="10dp"
                android:layout_marginBottom="10dp"
                android:background="@drawable/round_button_white"
                android:elevation="5dp"
                android:hint="Age"
                android:inputType="number"
                android:paddingStart="15dp"
                android:paddingEnd="10dp"
                android:textSize="15sp"/>


            <RadioGroup
                android:id="@+id/cgender"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:paddingStart="10dp"
                android:paddingEnd="10dp">

                <RadioButton
                    android:id="@+id/radio1"
                    android:layout_width="115dp"
                    android:layout_height="35dp"
                    android:layout_marginBottom="10dp"
                    android:background="@drawable/radio_flat_selector"
                    android:button="@android:color/transparent"
                    android:checked="true"
                    android:elevation="3dp"
                    android:gravity="center"
                    android:text="@string/male"
                    android:layout_weight="1"
                    android:textColor="@drawable/radio_flat_text_selector"
                    />

                <RadioButton
                    android:id="@+id/radio2"
                    android:layout_width="115dp"
                    android:layout_height="35dp"
                    android:layout_marginStart="10dp"
                    android:layout_marginBottom="10dp"
                    android:background="@drawable/radio_flat_selector"
                    android:button="@android:color/transparent"
                    android:elevation="5dp"
                    android:layout_weight="1"
                    android:gravity="center"
                    android:text="@string/female"
                    android:textColor="@drawable/radio_flat_text_selector"
                    />

            </RadioGroup>

            <EditText
                android:id="@+id/my_address"
                android:layout_width="match_parent"
                android:layout_height="40dp"
                android:layout_marginStart="10dp"
                android:layout_marginEnd="10dp"
                android:layout_marginBottom="10dp"
                android:background="@drawable/round_button_white"
                android:elevation="5dp"
                android:hint="Address"
                android:inputType="textPostalAddress"
                android:paddingStart="15dp"
                android:paddingEnd="10dp"
                android:textSize="12sp"/>

            <EditText
                android:id="@+id/my_pincode"
                android:layout_width="match_parent"
                android:layout_height="40dp"
                android:layout_marginStart="10dp"
                android:layout_marginEnd="10dp"
                android:layout_marginBottom="10dp"
                android:background="@drawable/round_button_white"
                android:elevation="5dp"
                android:hint="Pincode"
                android:inputType="number"
                android:paddingStart="15dp"
                android:paddingEnd="10dp"
                android:textSize="15sp"/>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="40dp"
                android:layout_marginStart="10dp"
                android:layout_marginEnd="10dp"
                android:layout_marginBottom="10dp"
                android:background="@drawable/round_button_white"
                android:elevation="5dp"
                android:orientation="horizontal"
                android:paddingStart="15dp"
                android:paddingEnd="10dp">

                <Spinner
                    android:id="@+id/cdistrict"
                    android:dropDownWidth="wrap_content"
                    android:spinnerMode="dropdown"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent" />

            </LinearLayout>

            <Button
                android:id="@+id/update_profile_btn"
                android:layout_width="wrap_content"
                android:layout_gravity="center_horizontal"
                android:layout_height="50dp"
                android:layout_marginBottom="15dp"
                android:layout_marginTop="15dp"
                android:background="@drawable/round_button_white"
                android:elevation="5dp"
                android:text="Update Profile"
                android:textAllCaps="false"
                app:backgroundTint="@color/orange" />

        </LinearLayout>
</ScrollView>



</LinearLayout>