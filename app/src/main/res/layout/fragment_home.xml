<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/white"
    android:orientation="vertical">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="?android:attr/actionBarSize"
        android:background="@color/orange"
        android:orientation="horizontal">

        <TextView
            android:layout_width="wrap_content"
            android:gravity="center_vertical"
            android:layout_height="match_parent"
            android:layout_marginStart="20dp"
            android:fontFamily="@font/blippo_black_regular"
            android:textColor="@color/white"
            android:textSize="25dp"
            android:text="@string/app_title" />

        <View
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:layout_weight="1" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="match_parent"
            android:gravity="center_vertical"
            android:paddingStart="20dp"
            android:paddingEnd="20dp"
            android:textColor="@color/white" />


    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="220dp">
        <androidx.viewpager2.widget.ViewPager2
            android:id="@+id/view_pager2"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"/>
    </LinearLayout>


    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:fillViewport="true">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="10dp">



            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="1dp"
                android:layout_marginTop="1dp"
                android:orientation="horizontal">

                <Button
                    android:layout_width="0dp"
                    android:layout_height="90dp"
                    android:layout_marginEnd="5dp"
                    android:layout_marginBottom="10dp"
                    android:layout_weight="1"
                    android:background="@drawable/round_button_15dp"
                    android:drawableTop="@drawable/ic_telephone"
                    android:elevation="5dp"
                    app:backgroundTint="@color/green"
                    android:gravity="bottom|center"
                    android:paddingBottom="10dp"
                    android:paddingTop="10dp"
                    android:textColor="@color/textBlack"
                    android:fontFamily="@font/lato_bold"
                    android:text="@string/request_a_call"
                    android:letterSpacing=".01"
                    android:textAllCaps="false" />

                <Button
                    android:layout_width="0dp"
                    android:layout_height="90dp"
                    android:layout_marginStart="5dp"
                    android:layout_marginBottom="10dp"
                    android:layout_weight="1"
                    android:maxLines="1"
                    android:background="@drawable/round_button_15dp"
                    android:drawableTop="@drawable/ic_presc_upload"
                    android:elevation="5dp"
                    app:backgroundTint="@color/green"
                    android:gravity="bottom|center"
                    android:paddingBottom="10dp"
                    android:fontFamily="@font/lato_bold"
                    android:paddingTop="10dp"
                    android:ellipsize="end"
                    android:letterSpacing=".01"
                    android:textColor="@color/textBlack"
                    android:text="@string/upload_prescription"
                    android:textAllCaps="false" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal">

                <Button
                    android:layout_width="0dp"
                    android:layout_height="90dp"
                    android:layout_marginEnd="5dp"
                    android:layout_marginBottom="10dp"
                    android:layout_weight="1"
                    android:background="@drawable/round_button_15dp"
                    android:drawableTop="@drawable/ic_lab_2"
                    android:elevation="5dp"
                    app:backgroundTint="@color/green"
                    android:gravity="bottom|center"
                    android:paddingBottom="10dp"
                    android:paddingTop="10dp"
                    android:textColor="@color/textBlack"
                    android:text="View Labs"
                    android:fontFamily="@font/lato_bold"
                    android:letterSpacing=".01"
                    android:textAllCaps="false" />

                <Button
                    android:layout_width="0dp"
                    android:layout_height="90dp"
                    android:layout_marginStart="5dp"
                    android:layout_marginBottom="10dp"
                    android:layout_weight="1"
                    android:background="@drawable/round_button_15dp"
                    android:drawableTop="@drawable/ic_book"
                    android:elevation="5dp"
                    app:backgroundTint="@color/green"
                    android:gravity="bottom|center"
                    android:paddingBottom="10dp"
                    android:paddingTop="10dp"
                    android:textColor="@color/textBlack"
                    android:text="@string/book_a_test"
                    android:fontFamily="@font/lato_bold"
                    android:letterSpacing=".01"
                    android:textAllCaps="false" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal">

                <TextView
                    android:layout_width="wrap_content"
                    android:paddingStart="15dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:textSize="15dp"
                    android:textColor="@color/green"
                    android:text="@string/health_packages"
                    android:textFontWeight="700"/>
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:paddingStart="10dp"
                    android:paddingEnd="15dp"
                    android:textColor="@color/green"
                    android:text="@string/view_all" />

            </LinearLayout>


            <RelativeLayout
                android:layout_width = "match_parent"
                android:layout_height = "200dp">

                <!-- Card View -->
                <androidx.cardview.widget.CardView
                    app:cardElevation ="4dp"
                    app:cardCornerRadius = "10dp"
                    android:foregroundGravity = "center"
                    android:layout_centerInParent = "true"
                    android:layout_width = "match_parent"
                    android:layout_height = "wrap_content"
                    app:cardUseCompatPadding="true">

                    <!-- simple image view -->
                    <ImageView
                        android:scaleType = "centerCrop"
                        android:padding="15dp"
                        android:src = "@drawable/ddrc"
                        android:layout_width = "match_parent"
                        android:layout_height = "match_parent"/>

                </androidx.cardview.widget.CardView>

            </RelativeLayout>

        </LinearLayout>
    </ScrollView>

</LinearLayout>