<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/transp_black"
    android:orientation="vertical">

    <TextView
        android:layout_width="match_parent"
        android:layout_height="40dp"
        android:background="@color/orange"
        android:gravity="center|start"
        android:paddingStart="10dp"
        android:paddingEnd="10dp"
        android:layout_marginBottom="5dp"
        android:text="Booking Details"
        android:textColor="@color/white"
        android:textSize="17sp"
        android:textStyle="bold" />

<ScrollView
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    >

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:paddingBottom="15dp"
                android:orientation="vertical">

                <androidx.cardview.widget.CardView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginHorizontal="8dp"
                    android:layout_marginVertical="4dp"
                    app:cardBackgroundColor="@color/white"
                    app:cardCornerRadius="5dp"
                    app:cardElevation="5dp">
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:paddingVertical="6dp"
                        android:orientation="vertical">

                <TextView android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:textStyle="bold"
                    android:textSize="15sp"
                    android:textColor="@color/black"
                    android:text="Patient Details"
                    android:paddingHorizontal="10dp"
                    android:paddingBottom="2dp"
                    />
                <TextView android:layout_width="match_parent"
                    android:id="@+id/pat_name"
                    android:layout_height="wrap_content"
                    android:textSize="13sp"
                    android:textColor="@color/green"
                    android:paddingHorizontal="10dp"
                    android:paddingBottom="2dp"
                    />
                <TextView android:layout_width="match_parent"
                    android:id="@+id/pat_age_gender"
                    android:layout_height="wrap_content"
                    android:textSize="13sp"
                    android:textColor="@color/green"
                    android:paddingHorizontal="10dp"
                    android:paddingBottom="2dp"
                    />

                <TextView android:layout_width="match_parent"
                    android:id="@+id/pat_address"
                    android:layout_height="wrap_content"
                    android:textSize="13sp"
                    android:textColor="@color/green"
                    android:paddingHorizontal="10dp"
                    android:paddingBottom="2dp"
                    />
                <TextView android:layout_width="match_parent"
                    android:id="@+id/pat_phone"
                    android:layout_height="wrap_content"
                    android:textSize="13sp"
                    android:textColor="@color/green"
                    android:paddingHorizontal="10dp"
                    android:paddingBottom="2dp"
                    />
                <TextView android:layout_width="match_parent"
                    android:id="@+id/pat_pincode_district"
                    android:layout_height="wrap_content"
                    android:textSize="13sp"
                    android:textColor="@color/green"
                    android:paddingHorizontal="10dp"
                    />
                    </LinearLayout>

            </androidx.cardview.widget.CardView>

                <androidx.cardview.widget.CardView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginHorizontal="8dp"
                    android:layout_marginVertical="4dp"
                    app:cardBackgroundColor="@color/white"
                    app:cardCornerRadius="5dp"
                    app:cardElevation="5dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:paddingVertical="6dp"
                        android:orientation="vertical">


                <TextView android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:textStyle="bold"
                    android:textSize="15sp"
                    android:textColor="@color/black"
                    android:text="Booking Details"
                    android:paddingHorizontal="10dp"
                    android:paddingBottom="2dp"
                    />
                <TextView android:layout_width="match_parent"
                    android:id="@+id/booking_date"
                    android:layout_height="wrap_content"
                    android:textSize="13sp"
                    android:textColor="@color/green"
                    android:paddingHorizontal="10dp"
                    android:paddingBottom="2dp"
                    />
                <TextView android:layout_width="match_parent"
                    android:id="@+id/book_id"
                    android:layout_height="wrap_content"
                    android:textSize="13sp"
                    android:textColor="@color/green"
                    android:paddingHorizontal="10dp"
                    android:paddingBottom="2dp"
                    />
                <TextView android:layout_width="match_parent"
                    android:id="@+id/sample_coll_date"
                    android:layout_height="wrap_content"
                    android:textSize="13sp"
                    android:textColor="@color/green"
                    android:paddingHorizontal="10dp"
                    />
                    </LinearLayout>

            </androidx.cardview.widget.CardView>

                <androidx.cardview.widget.CardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginHorizontal="8dp"
                android:layout_marginVertical="4dp"
                app:cardBackgroundColor="@color/white"
                app:cardCornerRadius="5dp"
                app:cardElevation="5dp">
                <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:paddingVertical="6dp"
                android:orientation="vertical">
                <TextView android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:textStyle="bold"
                    android:textSize="15sp"
                    android:textColor="@color/black"
                    android:text="Lab Details"
                    android:paddingHorizontal="10dp"
                    android:paddingBottom="2dp"
                    />
                <ProgressBar
                    android:id="@+id/progress_bar"
                    style="@style/Widget.AppCompat.ProgressBar"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    />
                <TextView android:layout_width="match_parent"
                    android:id="@+id/lab_name"
                    android:layout_height="wrap_content"
                    android:textSize="13sp"
                    android:textColor="@color/green"
                    android:paddingHorizontal="10dp"
                    android:paddingBottom="2dp"
                    />
                <TextView android:layout_width="match_parent"
                    android:id="@+id/lab_address"
                    android:layout_height="wrap_content"
                    android:textSize="13sp"
                    android:textColor="@color/green"
                    android:paddingHorizontal="10dp"
                    android:paddingBottom="2dp"
                    />
                <TextView android:layout_width="match_parent"
                    android:id="@+id/lab_pin_district"
                    android:layout_height="wrap_content"
                    android:textSize="13sp"
                    android:textColor="@color/green"
                    android:paddingHorizontal="10dp"
                    />
                    </LinearLayout>

                </androidx.cardview.widget.CardView>
                <androidx.cardview.widget.CardView
                    android:id="@+id/test_det_card"
                    android:visibility="gone"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginHorizontal="8dp"
                    android:layout_marginVertical="4dp"
                    app:cardBackgroundColor="@color/white"
                    app:cardCornerRadius="5dp"
                    app:cardElevation="5dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:paddingVertical="5dp"

                        android:layout_height="wrap_content"
                        android:orientation="vertical">

                        <TextView android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:textStyle="bold"
                            android:textSize="15sp"
                            android:textColor="@color/black"
                            android:text="Tests Details"
                            android:paddingHorizontal="10dp"
                            android:paddingBottom="2dp"
                            />
                        <androidx.recyclerview.widget.RecyclerView
                            android:layout_width="match_parent"
                            android:id="@+id/test_list_view"
                            android:layout_height="match_parent"
                            />

                    </LinearLayout>
                </androidx.cardview.widget.CardView>

                <androidx.cardview.widget.CardView
                    android:id="@+id/pack_det_card"
                    android:visibility="gone"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginHorizontal="8dp"
                    android:layout_marginVertical="4dp"
                    app:cardBackgroundColor="@color/white"
                    app:cardCornerRadius="5dp"
                    app:cardElevation="5dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical">
                        <TextView
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:textColor="@color/white"
                            android:background="@color/pack_col"
                            android:paddingVertical="4dp"
                            android:paddingHorizontal="10dp"
                            android:textSize="14sp"
                            android:id="@+id/pack_title"
                            android:shadowColor = "@color/txtShadow"
                            android:shadowDx = "2"
                            android:shadowDy = "2"
                            android:shadowRadius = "2"
                            />
                        <ImageView
                            android:id="@+id/pack_img"
                            android:layout_height="180dp"
                            android:layout_width="match_parent"
                            android:scaleType="fitXY"
                            />

                        <TextView
                            android:id="@+id/tests_details"
                            android:gravity="top"
                            android:paddingHorizontal="8dp"
                            android:paddingTop="3dp"
                            android:paddingBottom="5dp"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:ellipsize="end"
                            android:maxLines="25"
                            android:lineHeight="12sp"
                            android:letterSpacing=".01"
                            android:textColor="@color/textBlack"
                            android:textSize="12sp" />


                    </LinearLayout>

                </androidx.cardview.widget.CardView>


                <androidx.cardview.widget.CardView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginHorizontal="8dp"
                    android:layout_marginVertical="4dp"
                    app:cardBackgroundColor="@color/white"
                    app:cardCornerRadius="5dp"
                    app:cardElevation="5dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:paddingVertical="6dp"
                        android:layout_height="wrap_content"
                        android:orientation="vertical">

                <TextView android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:textStyle="bold"
                    android:textSize="15sp"
                    android:textColor="@color/black"
                    android:text="Charges Details"
                    android:paddingHorizontal="10dp"
                    android:paddingBottom="2dp"
                    />

                    <LinearLayout android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                        android:orientation="horizontal">

                        <TextView android:layout_width="0dp"
                            android:id="@+id/total_text"
                        android:layout_weight="2"
                        android:layout_height="wrap_content"
                        android:textSize="13sp"
                        android:text="Tests total"
                        android:textColor="@color/green"
                        android:paddingHorizontal="10dp"
                        android:paddingBottom="2dp"
                        />

                        <TextView
                            android:id="@+id/test_total"
                            android:layout_width="0dp"
                            android:layout_height="match_parent"
                            android:layout_weight="1"
                            android:paddingHorizontal="10dp"
                            android:paddingBottom="2dp"
                            android:textColor="@color/green"
                            android:textSize="13sp" />

                    </LinearLayout>

                    <LinearLayout android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal">
                        <TextView android:layout_width="0dp"
                            android:layout_weight="2"
                           android:text="Service charges"
                            android:layout_height="wrap_content"
                            android:textSize="13sp"
                            android:textColor="@color/green"
                            android:paddingHorizontal="10dp"
                            android:paddingBottom="2dp"
                            />


                <TextView android:layout_width="0dp"
                   android:layout_weight="1"
                    android:id="@+id/service_charges"
                    android:layout_height="wrap_content"
                    android:textSize="13sp"
                    android:textColor="@color/green"
                    android:paddingHorizontal="10dp"
                    />

                    </LinearLayout>
                        <View
                            android:layout_width="match_parent"
                            android:layout_height="1dp"
                            android:background="@color/orange"
                            android:layout_marginVertical="2dp"
                            />
                    <LinearLayout android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal">

                        <TextView android:layout_width="0dp"
                            android:layout_weight="2"
                            android:text="Grand Total"
                            android:layout_height="wrap_content"
                            android:textSize="13sp"
                            android:textColor="@color/green"
                            android:paddingHorizontal="10dp"

                            />


                        <TextView android:layout_width="0dp"
                            android:layout_weight="1"
                            android:id="@+id/grand_total"
                            android:layout_height="wrap_content"
                            android:textSize="13sp"
                            android:textStyle="bold"
                            android:textColor="@color/green"
                            android:paddingHorizontal="10dp"

                            />
                    </LinearLayout>




                    </LinearLayout>
                </androidx.cardview.widget.CardView>

            </LinearLayout>
</ScrollView>

</LinearLayout>