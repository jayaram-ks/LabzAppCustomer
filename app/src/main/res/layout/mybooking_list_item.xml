<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView
    android:layout_height="wrap_content"
    android:layout_width="match_parent"
    app:cardCornerRadius="10dp"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    app:strokeColor="@color/bluish_border"
    app:strokeWidth="1dp"
    app:cardBackgroundColor="@color/white"
    android:layout_marginVertical="4dp"
    xmlns:android="http://schemas.android.com/apk/res/android">

    <LinearLayout android:orientation="vertical"
        android:layout_width="match_parent"
        android:layout_height="wrap_content">
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textColor="@color/white"
            android:background="@color/bluish"
            android:paddingVertical="4dp"
            android:paddingHorizontal="10dp"
            android:textSize="14sp"
            android:id="@+id/patient_name"
            android:shadowColor = "@color/txtShadow"
            android:shadowDx="2"
            android:textStyle="bold"
            android:shadowDy="2"
            android:shadowRadius="2"
            />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:orientation="vertical"
                android:paddingHorizontal="6dp"
                >

                <TextView
                    android:id="@+id/book_lab_name"
                    android:gravity="top"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:maxLines="2"
                    android:paddingHorizontal="5dp"
                    android:paddingTop="3dp"
                    android:textStyle="bold"
                    android:letterSpacing=".01"
                    android:textColor="@color/black"
                    android:textSize="13sp" />

                <TextView
                    android:id="@+id/book_date"
                    android:gravity="top"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:maxLines="2"
                    android:paddingTop="3dp"
                    android:paddingHorizontal="5dp"
                    android:letterSpacing=".01"
                    android:textColor="@color/black"
                    android:textSize="12sp" />
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:paddingHorizontal="5dp"
                    android:gravity="center">
                    <TextView
                        android:id="@+id/down_report"
                        android:gravity="center_vertical"
                        android:layout_marginRight="3dp"
                        android:layout_width="0dp"
                        android:layout_height="40dp"
                        android:layout_weight="3"
                        android:textAllCaps="false"
                        android:textColor="@color/black"
                        android:fontFamily="@font/lato_regular"
                        android:textSize="12sp"
                        android:letterSpacing=".01"

                        />
                    <Button
                        android:id="@+id/view_details"
                        android:layout_gravity="end"
                        android:layout_width="0dp"
                        android:layout_height="40dp"
                        android:layout_weight="2"
                        android:text="View Details"
                        android:textAllCaps="false"
                        android:textColor="@color/white"
                        android:fontFamily="@font/lato_black"
                        android:textStyle="bold"
                        android:textSize="12sp"
                        android:letterSpacing=".01"
                        android:lineHeight="10sp"
                        android:backgroundTint="@color/orange"
                        />
                </LinearLayout>
        </LinearLayout>
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textColor="@color/white"
            android:background="@color/bluish"
            android:paddingVertical="5dp"
            android:paddingHorizontal="10dp"
            android:textSize="13sp"
            android:id="@+id/book_total"
            android:shadowColor = "@color/txtShadow"
            android:shadowDx = "1"
            android:shadowDy = "1"
            android:shadowRadius = "2"
            />
    </LinearLayout>
</com.google.android.material.card.MaterialCardView>